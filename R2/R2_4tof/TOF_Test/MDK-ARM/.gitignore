# ============================================
# TOF_Test — .gitignore (参考 R2 风格)
# ============================================

# ============================================
# Claude Code & AI tooling (local only)
# ============================================
.claude/
**/.claude/

# ============================================
# EmbeddedSkills tool state (local only)
# ============================================
**/.embeddedskills/

# ============================================
# VSCode (keep shared config, exclude logs)
# ============================================
.vscode/*.log
.vscode/*.log.lock

# ============================================
# EIDE — 忽略日志, 保留配置文件
# eide.yml + files.options.yml 使用相对路径，可以共享
# env.ini 仅含 KEIL_OUTPUT_DIR，可以共享
# ============================================
.eide/log/
.eide/log/*
.eide.usr.ctx.json

# ============================================
# CMSIS 设备包 (IDE 自动下载)
# ============================================
.cmsis/

# ============================================
# Keil MDK user & build artifacts
# ============================================
# User-specific (editor layout, debug settings)
*.uvoptx
*.uvguix.*
*.Administrator
*.uvgui.*

# Build outputs
*.hex
*.bin
*.axf
*.elf
*.o
*.d
*.crf
*.dep
*.iex
*.htm
*.lnp
*.plg
*.map
*.fed
*.lst

# Build config (auto-generated by IDE)
JLinkSettings.ini

# Scatter file loaded by IDE
*.scvd
*.sct
*.dbgconf

# Debug config
DebugConfig/

# RTE directory
RTE/

# Build directories
.build/
build/
*/build/
**/build/

# Keil 输出目录
Listings/
Objects/

# ============================================
# STM32CubeMX generated (keep .ioc only)
# ============================================
.mxproject

# ============================================
# CMake / GCC 构建产物
# ============================================
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json

# ============================================
# OS junk
# ============================================
Thumbs.db
.DS_Store
*.swp
*.swo
*~
*.bak
*.tmp
*.orig
